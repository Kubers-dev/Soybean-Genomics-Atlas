FROM rocker/r-ver:4.4.2
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-pip python3-venv libcurl4-openssl-dev libssl-dev libxml2-dev libfontconfig1-dev libfreetype6-dev libpng-dev libtiff5-dev libjpeg-dev make g++ && rm -rf /var/lib/apt/lists/*

RUN python3 -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"
RUN R -q -e "install.packages(c('remotes','readxl','data.table','bigmemory'), repos='https://cloud.r-project.org')"
RUN R -q -e "remotes::install_github('xiaolei-lab/rMVP@78fc9e636439c3b5171ee05d0460e3ad4df3129a')"
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY app.py GWAS_R_ONLINE.R ./
RUN mkdir -p runs
CMD ["python3","app.py"]
